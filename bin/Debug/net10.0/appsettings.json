{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.ReverseProxy": "Debug"
    }
  },
  "auth_path": {
    "login": "/api/Seguridad/v1/BancoPopular/iniciar-sesion-corresponsal",
    "validate": "/api/Seguridad/v1/BancoPopular/validar-sesion-corresponsal"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "SeguridadCorresponsalApi": {
        "ClusterId": "clusterSeguridadCorresponsalApi",
        "Match": {
          "Path": "/api/Seguridad/v1/BancoPopular/{**catch-all}",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "clusterSeguridadCorresponsalApi": {
        "Destinations": {
          "seguridadCorresponsalApi": {
            "Address": "%UrlBaseSeguridadCorresponsalApi%"
          }
        }
      }
    }
  }
}